# Storage backend: "local" (default for dev), "gcs", "s3", or leave blank to auto-detect.
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Google Cloud Storage (used when STORAGE_BACKEND=gcs)
GOOGLE_CLOUD_PROJECT=
STORAGE_BUCKET=weather-explorer

# AWS S3 (used when STORAGE_BACKEND=s3). Credentials come from AWS_* env vars / IAM.
AWS_REGION=us-east-1

# Comma-separated list of allowed CORS origins, "*" = allow all (dev).
CORS_ORIGINS=*

# Upstream Open-Meteo timeout in seconds.
OPENMETEO_TIMEOUT=15
